# PyMarkup Configuration File
# Copy this file to config.yaml and fill in your credentials
# DO NOT commit config.yaml to version control!

# API Credentials
credentials:
  # FRED API Key for CPI download (required)
  # Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
  fred_api_key: "your_fred_api_key_here"

  # WRDS username for Compustat download (optional)
  # If not provided, uses default WRDS authentication (~/.pgpass)
  wrds_username: null

# Data paths
data:
  # Input data directory
  input_dir: "Input"

  # Intermediate results directory
  intermediate_dir: "Intermediate"

  # Output directory
  output_dir: "Output"

# Pipeline configuration
pipeline:
  # Estimation method: "wooldridge_iv", "cost_share", "acf", or "all"
  method: "wooldridge_iv"

  # IV specification: "spec1" (COGS+K) or "spec2" (COGS+K+SGA)
  iv_specification: "spec2"

  # Rolling window size in years
  window_years: 5

  # Minimum observations per industry-year window
  min_observations: 15

  # Industry aggregation level (2, 3, or 4 digit NAICS)
  industry_level: 2

# Data processing
data_processing:
  # Percentile trimming bounds [lower, upper]
  trim_percentiles: [0.01, 0.99]

  # Include interest in COGS
  include_interest_cogs: false

  # Save intermediate results
  save_intermediate: true
