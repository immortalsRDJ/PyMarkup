# PyMarkup Configuration - API Keys and Credentials
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control!

# FRED API Key (for CPI download)
# Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# WRDS Username (for Compustat download)
# Requires institutional access through your university
# Optional: If not provided, will use default WRDS authentication (~/.pgpass)
WRDS_USERNAME=your_wrds_username

# Alternative: Use config.yaml instead of .env
# See config.yaml.example for YAML-based configuration
